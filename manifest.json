{
  "manifest_version": 3,
  "name": "MusicPresence",
  "version": "1.0.0",
  "description": "Mostra o que você está ouvindo no YouTube Music como Rich Presence no Discord.",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "YouTube Music no Discord",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ytmusic-discord-rpc@local",
      "strict_min_version": "109.0"
    }
  }
}
